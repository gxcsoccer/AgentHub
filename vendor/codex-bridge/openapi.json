        "operationId": "interruptTurn",
        "summary": "Interrupt the specified turn",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Success; Codex response fields are preserved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Structured bridge or Codex error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "turnId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": ["turnId"]
              }
            }
          }
        }
      }
    },
    "/v1/events": {
      "get": {
        "operationId": "events",
        "summary": "SSE for this connection; attach explicitly to receive existing session events",
        "parameters": [
          {
            "name": "sessionId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success; Codex response fields are preserved",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "SSE frames carrying Event envelopes; ready frames contain cursor and connected."
                }
              }
            }
          },
          "default": {
            "description": "Structured bridge or Codex error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/requests": {
      "get": {
        "operationId": "pendingRequests",
        "summary": "List unresolved approvals, questions and other server requests",
        "parameters": [
          {
            "name": "sessionId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success; Codex response fields are preserved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PendingRequests"
                }
              }
            }
          },
          "default": {
            "description": "Structured bridge or Codex error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/requests/{requestId}/response": {
      "post": {
        "operationId": "respondToRequest",
        "summary": "Explicitly forward a Codex result or error; never approves automatically",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Success; Codex response fields are preserved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseReceipt"
                }
              }
            }
          },
          "default": {
            "description": "Structured bridge or Codex error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "result": {
                    "type": "object"
                  },
                  "error": {
                    "type": "object"
                  }
                },
                "oneOf": [
                  {
                    "required": ["result"],
                    "not": {
                      "required": ["error"]
                    }
                  },
                  {
                    "required": ["error"],
                    "not": {
                      "required": ["result"]
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error"]
      },
      "Session": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": ["string", "null"]
          },
          "cwd": {
            "type": "string"
          },
          "status": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "type": {
                "type": "string"
              }
            },
            "required": ["type"]
          },
          "canAcceptDirectInput": {
            "type": ["boolean", "null"]
          },
          "parentThreadId": {
            "type": ["string", "null"]
          }
        },
        "required": ["id"]
      },
      "SessionResult": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "thread": {
            "$ref": "#/components/schemas/Session"
          }
        },
        "required": ["thread"]
      },
      "SessionPage": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Session"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          },
          "backwardsCursor": {
            "type": ["string", "null"]
          }
        },
        "required": ["data", "nextCursor"]
      },
      "LoadedPage": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          },
          "backwardsCursor": {
            "type": ["string", "null"]
          }
        },
        "required": ["data", "nextCursor"]
      },
      "SearchPage": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "thread": {
                  "$ref": "#/components/schemas/Session"
                },
                "snippet": {
                  "type": "string"
                }
              },
              "required": ["thread", "snippet"]
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          },
          "backwardsCursor": {
            "type": ["string", "null"]
          }
        },
        "required": ["data", "nextCursor"]
      },
      "Occurrence": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "turnId": {
            "type": "string"
          },
          "itemId": {
            "type": "string"
          },
          "snippet": {
            "type": "string"
          },
          "snippetMatchRange": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": ["start", "end"]
          },
          "turnCursor": {
            "type": "string"
          }
        },
        "required": ["turnId", "itemId", "snippet", "snippetMatchRange", "turnCursor"]
      },
      "OccurrencePage": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Occurrence"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          },
          "backwardsCursor": {
            "type": ["string", "null"]
          }
        },
        "required": ["data", "nextCursor"]
      },
      "Turn": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "error": {
            "type": ["object", "null"],
            "additionalProperties": true
          }
        },
        "required": ["id", "status"]
      },
      "TurnPage": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Turn"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          },
          "backwardsCursor": {
            "type": ["string", "null"]
          }
        },
        "required": ["data", "nextCursor"]
      },
      "ItemEntry": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "turnId": {
            "type": "string"
          },
          "item": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            },
            "required": ["id", "type"]
          },
          "startedAtMs": {
            "type": ["integer", "null"]
          },
          "completedAtMs": {
            "type": ["integer", "null"]
          }
        },
        "required": ["turnId", "item"]
      },
      "ItemPage": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemEntry"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          },
          "backwardsCursor": {
            "type": ["string", "null"]
          }
        },
        "required": ["data", "nextCursor"]
      },
      "MessageReceipt": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "status": {
            "const": "accepted"
          },
          "sessionId": {
            "type": "string"
          },
          "turnId": {
            "type": "string"
          },
          "messageId": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "mode": {
            "enum": ["start", "steer"]
          }
        },
        "required": ["status", "sessionId", "turnId", "messageId", "source", "mode"]
      },
      "Event": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "sessionId": {
            "type": ["string", "null"]
          },
          "turnId": {
            "type": ["string", "null"]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": ["id", "type", "sessionId", "turnId", "timestamp", "data"]
      },
      "PendingRequest": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "sessionId": {
            "type": ["string", "null"]
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": ["id", "method", "sessionId", "params"]
      },
      "PendingRequests": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PendingRequest"
            }
          }
        },
        "required": ["data"]
      },
      "ResponseReceipt": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "status": {
            "const": "submitted"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": ["status", "requestId"]
      },
      "Capabilities": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "version": {
            "type": "string"
          },
          "connected": {
            "type": "boolean"
          },
          "eventCursor": {
            "type": "string"
          },
          "nativeAgentMessaging": {
            "const": false
          },
          "idempotency": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "retentionHours": {
                "const": 24
              },
              "durable": {
                "const": false
              }
            },
            "required": ["retentionHours", "durable"]
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "version",
          "connected",
          "eventCursor",
          "nativeAgentMessaging",
          "idempotency",
          "operations"
        ]
      }
    }
  }
}
